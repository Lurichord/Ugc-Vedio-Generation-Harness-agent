        "script_segment_id": "ss03",
        "planned_beat_id": "pb03",
        "text": "粉水比就是咖啡粉和冲煮用水的比例。它是影响口感的核心参数。",
        "delivery_hint": {
          "speech_act": "explanation",
          "emphasis_words": [
            "比例",
            "核心参数"
          ],
          "pause_before_ms": 0,
          "pause_after_ms": 120,
          "energy": "medium"
        }
      },
      {
        "script_segment_id": "ss04",
        "planned_beat_id": "pb04",
        "text": "很多新手都错了，粉水比根本不是固定的1:15或1:16",
        "delivery_hint": {
          "speech_act": "claim",
          "emphasis_words": [
            "根本不是固定"
