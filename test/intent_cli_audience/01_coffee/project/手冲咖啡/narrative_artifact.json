            "统一标准"
          ],
          "pause_before_ms": 0,
          "pause_after_ms": 120,
          "energy": "medium"
        }
      },
      {
        "script_segment_id": "ss06",
        "planned_beat_id": "pb06",
        "text": "那我们自己日常喝，到底该用什么比例？",
        "delivery_hint": {
          "speech_act": "question",
