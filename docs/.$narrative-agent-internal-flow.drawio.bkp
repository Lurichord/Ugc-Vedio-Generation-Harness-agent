<mxfile host="app.diagrams.net" modified="2026-08-13T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="narrative-internal" name="Narrative Agent内部流程">
    <mxGraphModel dx="5600" dy="3700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5600" pageHeight="3700" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Narrative Agent 内部流程：自主 Tool Loop、stdio MCP 与三种 Format 工具&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Harness 只提供任务契约并接收候选；Agent 自主选择工具和修复路径；MCP Server 保存本次任务的临时草稿。&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="5420" height="75" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;图例：&lt;/b&gt;蓝色＝Agent 控制流　绿色＝MCP 调用结果/候选　橙色＝MCP Server 与任务内草稿　紫色＝LLM 结构化生成　红色＝错误反馈与失败　灰色＝Harness 边界" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=15;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="5420" height="55" as="geometry"/></mxCell>

        <mxCell id="h-in" value="&lt;b&gt;HARNESS → Narrative Agent&lt;/b&gt;&lt;br&gt;&lt;b&gt;TaskEnvelope：&lt;/b&gt;task_id, goal, scope, based_on_state_version, format_id, agent_instructions, allowed_tools[], required_outputs[], forbidden_actions[], acceptance_criteria[], budget, input_hash, dependency_snapshot[]&lt;br&gt;&lt;b&gt;CreativeBrief：&lt;/b&gt;project_id, topic, target, audience, communication, production_mode, video_profile, content_policy&lt;br&gt;&lt;b&gt;Agent 配置：&lt;/b&gt;model_name, generation_context?, StdioMCPServerConfig" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="225" width="1120" height="255" as="geometry"/></mxCell>
        <mxCell id="h-out" value="&lt;b&gt;Narrative Agent → HARNESS&lt;/b&gt;&lt;br&gt;&lt;b&gt;NarrativeAgentExecution：&lt;/b&gt;world_state?, planning?, script?, shots?, result&lt;br&gt;&lt;b&gt;AgentResult：&lt;/b&gt;task_id, status, state_version_used, input_hash, actions[], artifact_refs[], proposed StatePatch, evaluation_target?, error?&lt;br&gt;&lt;b&gt;注意：&lt;/b&gt;返回的是候选和建议；Narrative Critic 与正式 Commit 在 Agent 外部由 Harness 执行。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="4310" y="225" width="1180" height="255" as="geometry"/></mxCell>

        <mxCell id="agent-zone" value="NARRATIVE AGENT（agent.py）" style="swimlane;html=1;rounded=1;startSize=55;horizontal=1;fillColor=#EAF2FF;strokeColor=#2563EB;strokeWidth=3;fontColor=#1E3A8A;fontStyle=1;fontSize=22;" vertex="1" parent="1"><mxGeometry x="1280" y="200" width="2940" height="1780" as="geometry"/></mxCell>
        <mxCell id="run" value="&lt;b&gt;1　run(task, brief)&lt;/b&gt;&lt;br&gt;validate_task(task)&lt;br&gt;CreativeBrief 类型检查&lt;br&gt;asyncio.run(_run_mcp(task, brief))" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="290" width="620" height="170" as="geometry"/></mxCell>
        <mxCell id="precheck" value="&lt;b&gt;2　_run_mcp() Agent 前置检查&lt;/b&gt;&lt;br&gt;actions = []&lt;br&gt;必须存在 task.format_id 与 required_outputs&lt;br&gt;brief.production_mode 必须与 task.format_id 对齐（auto 除外）&lt;br&gt;失败 → failed_result，不启动 MCP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2070" y="275" width="720" height="200" as="geometry"/></mxCell>
        <mxCell id="messages" value="&lt;b&gt;3　初始化 messages[]&lt;/b&gt;&lt;br&gt;system.content = task.agent_instructions || task.goal&lt;br&gt;user.content = JSON{task: TaskEnvelope, creative_brief: CreativeBrief}&lt;br&gt;&lt;br&gt;之后每次 tool call、tool result、tool error 和继续规划提示都会追加到这里；它是模型下一步决策的可见上下文。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2880" y="270" width="1240" height="210" as="geometry"/></mxCell>

        <mxCell id="stdio" value="&lt;b&gt;4　启动 stdio MCP 子进程&lt;/b&gt;&lt;br&gt;stdio_client(mcp_server.server_parameters())&lt;br&gt;→ (read, write)&lt;br&gt;ClientSession(read, write)&lt;br&gt;→ await session.initialize()&lt;br&gt;&lt;br&gt;ClientSession 是 MCP 协议会话，不是业务 JSON，也不保存正式项目状态。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="540" width="760" height="235" as="geometry"/></mxCell>
        <mxCell id="discover" value="&lt;b&gt;5　发现并校验 MCP 工具&lt;/b&gt;&lt;br&gt;listing = await session.list_tools()&lt;br&gt;discovered = {tool.name: tool}&lt;br&gt;required = {configure_task} ∪ task.allowed_tools&lt;br&gt;缺少任一 required tool → RuntimeError&lt;br&gt;&lt;br&gt;configure_task 必须存在，但不会暴露给模型自主选择。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2220" y="540" width="800" height="235" as="geometry"/></mxCell>
        <mxCell id="configure" value="&lt;b&gt;6　Agent 主动调用 configure_task&lt;/b&gt;&lt;br&gt;_call_mcp_tool(session, &quot;narrative.configure_task&quot;, {brief, model, generation_context}, record=False)&lt;br&gt;&lt;br&gt;它只初始化 MCP Server 的本次任务 Session；不计入 actions[]，也不消耗模型自主 Action 记录。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3120" y="540" width="1000" height="235" as="geometry"/></mxCell>

        <mxCell id="expose" value="&lt;b&gt;7　构造模型可见工具&lt;/b&gt;&lt;br&gt;逐个读取 task.allowed_tools&lt;br&gt;仅保留 discovered ∩ allowed_tools&lt;br&gt;MCP name → safe model name&lt;br&gt;model_tools[] = {name, description, parameters=MCP input_schema}&lt;br&gt;exposed[safe_name] = active MCP name&lt;br&gt;&lt;br&gt;FormatPack 决定白名单；模型只能从白名单内自主选工具。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="840" width="930" height="255" as="geometry"/></mxCell>
        <mxCell id="budget" value="&lt;b&gt;8　检查 Action Budget&lt;/b&gt;&lt;br&gt;while candidate is None&lt;br&gt;len(actions) &lt; task.budget.max_steps ?&lt;br&gt;否 → task step budget exhausted → failed_result" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2440" y="850" width="620" height="235" as="geometry"/></mxCell>
        <mxCell id="choose" value="&lt;b&gt;9　模型自主规划下一步&lt;/b&gt;&lt;br&gt;tool_model.choose_tool(messages, model_tools)&lt;br&gt;OpenAI tool_choice = required&lt;br&gt;必须且只能返回 1 个 ModelToolCall&lt;br&gt;ModelToolCall{name, arguments: dict, call_id}&lt;br&gt;&lt;br&gt;Harness/Agent 没有固定内部 dependency graph；模型根据当前 messages 决定生成、重做、修复或提交。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3170" y="825" width="950" height="280" as="geometry"/></mxCell>

        <mxCell id="permission" value="&lt;b&gt;10　权限映射与调用准备&lt;/b&gt;&lt;br&gt;active_name = exposed.get(decision.name)&lt;br&gt;不存在 → PermissionError&lt;br&gt;arguments = dict(decision.arguments)&lt;br&gt;messages.append(decision.assistant_message())" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="1190" width="720" height="200" as="geometry"/></mxCell>
        <mxCell id="call" value="&lt;b&gt;11　_call_mcp_tool()&lt;/b&gt;&lt;br&gt;await session.call_tool(active_name, arguments)&lt;br&gt;is_error=true → RuntimeError&lt;br&gt;优先读取 structured_content&lt;br&gt;否则读取 content.text 并 json.loads&lt;br&gt;兼容解包 {result: {...}}&lt;br&gt;最终必须得到 dict" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2180" y="1170" width="760" height="245" as="geometry"/></mxCell>
        <mxCell id="action" value="&lt;b&gt;12　ActionRecord 审计&lt;/b&gt;&lt;br&gt;record=True 时，无论成功或失败都追加：&lt;br&gt;action_id / agent / task_id / tool&lt;br&gt;result=success|failed&lt;br&gt;reason? / duration_ms&lt;br&gt;&lt;br&gt;ActionRecord 只记录调用事实，不控制 Agent 下一步。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3040" y="1170" width="700" height="245" as="geometry"/></mxCell>
        <mxCell id="feedback" value="&lt;b&gt;13　结果回灌 messages[]&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;&lt;b&gt;成功：&lt;/b&gt;&lt;/font&gt;追加 role=tool 的结构化 JSON；若不是 submit，再追加“判断还缺什么”的 user 提示&lt;br&gt;&lt;font color=&quot;#B91C1C&quot;&gt;&lt;b&gt;失败：&lt;/b&gt;&lt;/font&gt;追加 role=tool 的 {error} 和“根据错误选择下一步”的 user 提示&lt;br&gt;&lt;br&gt;随后返回 Budget → choose_tool；模型自行决定修复哪个草稿。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1360" y="1490" width="1110" height="260" as="geometry"/></mxCell>
        <mxCell id="is-submit" value="&lt;b&gt;active_name ==&lt;br&gt;narrative.submit_candidate ?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2630" y="1510" width="520" height="220" as="geometry"/></mxCell>
        <mxCell id="validate-candidate" value="&lt;b&gt;14　接受 Candidate&lt;/b&gt;&lt;br&gt;NarrativeCandidate.model_validate(value)&lt;br&gt;_validate_candidate_for_task(task, candidate)&lt;br&gt;检查 required_outputs、planning 类型、script 规则与 format 对齐&lt;br&gt;通过 → 退出 Tool Loop&lt;br&gt;失败 → 外层异常转 failed_result" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3300" y="1485" width="820" height="250" as="geometry"/></mxCell>
        <mxCell id="complete-result" value="&lt;b&gt;15　组装 NarrativeAgentExecution&lt;/b&gt;&lt;br&gt;复制 candidate.world_state / planning / script / shots&lt;br&gt;_completed_result() 创建 AgentResult：status=completed、state_version_used、input_hash、actions[]、artifact_refs[]、proposed StatePatch&lt;br&gt;返回 Harness；Agent 不执行 Critic 和正式 Commit。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2600" y="1800" width="1520" height="145" as="geometry"/></mxCell>

        <mxCell id="server-zone" value="STDIO MCP SERVER（mcp_servers/narrative.py，任务子进程）" style="swimlane;html=1;rounded=1;startSize=55;horizontal=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;fontColor=#9A3412;fontStyle=1;fontSize=21;" vertex="1" parent="1"><mxGeometry x="70" y="2050" width="5420" height="1430" as="geometry"/></mxCell>
        <mxCell id="server-config" value="&lt;b&gt;configure_task(brief, model, generation_context)&lt;/b&gt;&lt;br&gt;CreativeBrief.model_validate(brief)&lt;br&gt;LLMSettings.from_environment(model) → StructuredLLM&lt;br&gt;production_mode=auto → explainer；否则使用指定 format&lt;br&gt;创建对应 FormatSessionState" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="2140" width="1000" height="210" as="geometry"/></mxCell>
        <mxCell id="session" value="&lt;b&gt;NarrativeTaskSession（仅本次 stdio 子进程）&lt;/b&gt;&lt;br&gt;brief: CreativeBrief&lt;br&gt;generator: StructuredLLM&lt;br&gt;format_id: explainer | drama | tutorial&lt;br&gt;format_state: ExplainerFormatState | DramaFormatState | TutorialFormatState&lt;br&gt;generation_context: {instruction?, scope_note?, baselines?}&lt;br&gt;world_state? / planning? / script? / shots?&lt;br&gt;&lt;br&gt;这里保存工具间共享草稿；不是 Harness 正式 ProjectState。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="2120" width="1080" height="250" as="geometry"/></mxCell>
        <mxCell id="format-gate" value="&lt;b&gt;调用工具时检查当前 FormatState 类型&lt;/b&gt;&lt;br&gt;_explainer_state() / _drama_state() / _tutorial_state()&lt;br&gt;跨格式工具调用 → RuntimeError → 错误返回 Agent messages[]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2430" y="2130" width="820" height="225" as="geometry"/></mxCell>
        <mxCell id="structured" value="&lt;b&gt;统一 StructuredLLM.generate(prompt, output_type)&lt;/b&gt;&lt;br&gt;业务 Prompt + current draft + problems[]&lt;br&gt;+ generation_context 的 baseline / instruction / scope_note&lt;br&gt;+ output_type.model_json_schema()&lt;br&gt;调用模型 response_format=json_object&lt;br&gt;_extract_json → output_type.model_validate&lt;br&gt;首次校验失败：把 ValidationError 与旧输出加入 repair_prompt，低温重试 1 次&lt;br&gt;仍失败 → RuntimeError 返回 Agent Tool Loop" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3370" y="2110" width="2010" height="270" as="geometry"/></mxCell>

        <mxCell id="explainer" value="&lt;b&gt;EXPLAINER 工具与草稿&lt;/b&gt;&lt;br&gt;&lt;b&gt;plan_sections(problems?)&lt;/b&gt; → SectionPlanArtifact；写 section_plan + world_state&lt;br&gt;&lt;b&gt;expand_beats(problems?)&lt;/b&gt; → BeatPlanArtifact；要求 section_plan；组装 PlanningArtifact&lt;br&gt;&lt;b&gt;write_script(problems?)&lt;/b&gt; → ScriptArtifact；要求 planning&lt;br&gt;&lt;b&gt;compile_shots(problems?)&lt;/b&gt; → ShotPlanArtifact；确定性编译 planning + script&lt;br&gt;&lt;br&gt;Required outputs：planning + script + shots&lt;br&gt;Shot：shot_kind=explainer；visual=explainer；audio=external_narration" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=14;" vertex="1" parent="1"><mxGeometry x="140" y="2460" width="1640" height="350" as="geometry"/></mxCell>
        <mxCell id="drama" value="&lt;b&gt;DRAMA 工具与草稿&lt;/b&gt;&lt;br&gt;&lt;b&gt;design_world(problems?)&lt;/b&gt; → DramaWorldArtifact；写 world + world_state&lt;br&gt;&lt;b&gt;plan_story(problems?)&lt;/b&gt; → DramaStoryArtifact；写 story/scenes&lt;br&gt;&lt;b&gt;expand_scenes(problems?)&lt;/b&gt; → DramaActionPlanArtifact；要求 story；组装 DramaPlanningArtifact&lt;br&gt;&lt;b&gt;compile_shots(problems?)&lt;/b&gt; → ShotPlanArtifact；组装 world + story + actions&lt;br&gt;&lt;br&gt;Required outputs：world_state + planning + shots；script 必须为空&lt;br&gt;Shot：generated_scene + embedded_in_video；音频随 AI Video 生成" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F3E8FF;strokeColor=#9333EA;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1920" y="2460" width="1640" height="350" as="geometry"/></mxCell>
        <mxCell id="tutorial" value="&lt;b&gt;TUTORIAL 工具与草稿&lt;/b&gt;&lt;br&gt;&lt;b&gt;define_result(problems?)&lt;/b&gt; → TutorialDefinitionArtifact；写 definition + world_state&lt;br&gt;&lt;b&gt;plan_steps(problems?)&lt;/b&gt; → TutorialProcedureArtifact；组装 TutorialPlanningArtifact&lt;br&gt;&lt;b&gt;plan_explanations(problems?)&lt;/b&gt; → TutorialScriptArtifact；只写有增量价值的讲解&lt;br&gt;&lt;b&gt;compile_shots(problems?)&lt;/b&gt; → ShotPlanArtifact；要求 planning + explanation script&lt;br&gt;&lt;br&gt;Required outputs：world_state + planning + script + shots&lt;br&gt;Shot：procedure_demo + mixed audio；制作动作是画面主体" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#ECFCCB;strokeColor=#65A30D;fontSize=14;" vertex="1" parent="1"><mxGeometry x="3700" y="2460" width="1640" height="350" as="geometry"/></mxCell>

        <mxCell id="submit" value="&lt;b&gt;narrative.submit_candidate()&lt;/b&gt;&lt;br&gt;读取 NarrativeTaskSession 当前草稿，不再调用生成模型&lt;br&gt;Explainer：section + beats + script + shots 必须完整&lt;br&gt;Drama：world + story + action_plan + shots 必须完整&lt;br&gt;Tutorial：definition + procedure + TutorialScript + shots 必须完整&lt;br&gt;缺失字段 → ValueError（可修复错误）&lt;br&gt;完整 → NarrativeCandidate{world_state, planning, script?, shots}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="2920" width="3060" height="250" as="geometry"/></mxCell>
        <mxCell id="candidate-schema" value="&lt;b&gt;NarrativeCandidate Schema&lt;/b&gt;&lt;br&gt;world_state?: VideoWorldState&lt;br&gt;planning?: PlanningArtifact | DramaPlanningArtifact | TutorialPlanningArtifact&lt;br&gt;script?: ScriptArtifact | TutorialScriptArtifact&lt;br&gt;shots?: ShotPlanArtifact{shots: ProductionShot[]}&lt;br&gt;内部 model_validator 检查 world_state 对齐、planning/script 类型匹配、Drama 无外部 script、Tutorial step 引用有效。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1330" y="3230" width="2840" height="190" as="geometry"/></mxCell>

        <mxCell id="e1" value="TaskEnvelope + CreativeBrief" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="h-in" target="run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="validated inputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="run" target="precheck"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="checks pass" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="precheck" target="messages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="open subprocess" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="messages" target="stdio"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="4160" y="500"/><mxPoint x="1740" y="500"/></Array></mxGeometry></mxCell>
        <mxCell id="e5" value="initialized ClientSession" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="stdio" target="discover"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="required tools available" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#2563EB;strokeWidth=3;fontSize=14;" edge="1" parent="1" source="discover" target="configure"><mxGeometry relative="1" as="geometry"/></mxCell>
