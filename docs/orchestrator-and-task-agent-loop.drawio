<mxfile host="Electron" agent="Cursor">
  <diagram id="orch-task-loop" name="Orchestrator 与 Task Agent Loop">
    <mxGraphModel dx="1201" dy="690" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#0F172A;fontStyle=1;" value="当前项目总览：Orchestrator（意图层）与 Task Agent Loop（统一 GenericAgent）&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:13px;&quot;&gt;对应架构图的上半部分。Cognitive Twin 尚未设计，本图省略。Harness / ProjectState / Stage 只列现行字段。&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="2400" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=13;" value="&lt;b&gt;图例&lt;/b&gt;　玫红框＝核心设计　蓝框＝工作副本 / 注入视图　橙条＝账本字段　紫条＝阶段字段　实线＝控制流　虚线＝只读投影或回写　灰字＝未接线" vertex="1">
          <mxGeometry height="40" width="2400" x="40" y="76" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;&quot;&gt;CLI：python -m ugc_harness.intake&lt;br&gt;API：/api/intake/sessions&lt;br&gt;一拍回一句&lt;/font&gt;" vertex="1">
          <mxGeometry height="120" width="180" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="orch" parent="1" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontStyle=1;fontSize=16;" value="Orchestrator　意图解析层　intake/　" vertex="1">
          <mxGeometry height="700" width="1040" x="250" y="140" as="geometry" />
        </mxCell>
        <mxCell id="orch-flow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=12;" value="&lt;b&gt;每一拍（IntentHost.respond）&lt;/b&gt;&lt;br&gt;① inbound 入　② refresh progress（有项目则读 VideoState）　③ 拼 IntentView　④ IntentAgent.generate → IntakeTurn　⑤ Pydantic 合并工作副本　⑥ 按 address 分流，harness 回信再注一次" vertex="1">
          <mxGeometry height="72" width="1000" x="270" y="196" as="geometry" />
        </mxCell>
        <mxCell id="orch-sense" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;感知意图&lt;/b&gt;&lt;br&gt;Inbound&lt;br&gt;source: user | harness&lt;br&gt;text: 上一拍来信&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="118" width="230" x="270" y="282" as="geometry" />
        </mxCell>
        <mxCell id="orch-plan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;规划解析&lt;/b&gt;&lt;br&gt;注入 agent.md + IntentView&lt;br&gt;StructuredLLM.generate&lt;br&gt;自己填 brief / intent&lt;br&gt;自己写 check.ok / issues" vertex="1">
          <mxGeometry height="118" width="250" x="516" y="282" as="geometry" />
        </mxCell>
        <mxCell id="orch-reply" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;任务回复&lt;/b&gt;&lt;br&gt;address=user → 只问一件事&lt;br&gt;address=harness → 推字段&lt;br&gt;address=done → 收工&lt;br&gt;check.ok=false 不许开工" vertex="1">
          <mxGeometry height="118" width="230" x="782" y="282" as="geometry" />
        </mxCell>
        <mxCell id="orch-gate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;与 Harness 对话&lt;/b&gt;&lt;br&gt;start_project / inspect / run_stage&lt;br&gt;brief 过不了 Pydantic → 当 harness 来信打回&lt;br&gt;run_stage 第一刀：尚未接线&lt;br&gt;改问题＝重写 brief/intent，不碰镜头" vertex="1">
          <mxGeometry height="118" width="242" x="1028" y="282" as="geometry" />
        </mxCell>
        <mxCell id="orch-view" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" value="&lt;b&gt;IntentView　唯一注入文档（view.py ）&lt;/b&gt;&lt;br&gt;brief: BriefDraft　topic / production_mode / video_profile / target / audience / communication / content_policy&lt;br&gt;intent: IntentDraft　format_id / topic / one_sentence_thesis / promise / audience / communication / target / presentation?&lt;br&gt;progress: project_id, state_version, narrative, script, voice, editorial, asset, timeline, render&lt;br&gt;inbound: source, text&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;不给 world / structure / shots / timeline / voice.utterances / dependency_graph / trajectory&lt;/font&gt;" vertex="1">
          <mxGeometry height="168" width="500" x="270" y="414" as="geometry" />
        </mxCell>
        <mxCell id="orch-turn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" value="&lt;b&gt;IntakeTurn　模型直接返回&lt;/b&gt;&lt;br&gt;brief / intent　本拍覆盖字段&lt;br&gt;check {ok, issues[]}&lt;br&gt;address: user | harness | done&lt;br&gt;message　给对端的一句话&lt;br&gt;harness_request?&lt;br&gt;　action: start_project | run_stage | inspect&lt;br&gt;　stage?: narrative…render" vertex="1">
          <mxGeometry height="168" width="484" x="786" y="414" as="geometry" />
        </mxCell>
        <mxCell id="orch-mem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=12;" value="&lt;b&gt;Orchestrator Working Mem　IntakeSession&lt;/b&gt;&lt;br&gt;session_id / status: waiting_user | talking_to_harness | done / project_id / project_dir&lt;br&gt;working_brief: BriefDraft　　working_intent: IntentDraft　　progress: ProgressSnapshot&lt;br&gt;last_check / last_address / last_message / last_harness_request / inbound / messages[]&lt;br&gt;模型下一拍只看 IntentView，不看完整聊天记录；工作副本承载累计字段。" vertex="1">
          <mxGeometry height="124" width="1000" x="270" y="596" as="geometry" />
        </mxCell>
        <mxCell id="loop" parent="1" style="swimlane;html=1;rounded=1;startSize=42;horizontal=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontStyle=1;fontSize=16;" value="Task Agent Loop　GenericAgent　感知 / 规划 / 行动 / 反馈　每 task 重置 messages" vertex="1">
          <mxGeometry height="700" width="1110" x="1330" y="140" as="geometry" />
        </mxCell>
        <mxCell id="loop-flow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FDF2F8;strokeColor=#DB2777;fontSize=12;" value="&lt;b&gt;统一循环（六个制作阶段共用，差异全是数据）&lt;/b&gt;&lt;br&gt;预算门禁 → choose_tool → 白名单 → transport.call → ActionRecord → 刷新 StateView 注入 messages → 直到 *.submit_candidate。Critic / Commit 在 Harness，不在 loop 内。" vertex="1">
          <mxGeometry height="72" width="1070" x="1350" y="196" as="geometry" />
        </mxCell>
        <mxCell id="loop-sense" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;感知&lt;/b&gt;&lt;br&gt;system = agent_instructions&lt;br&gt;user = {TaskEnvelope, context}&lt;br&gt;之后看 StateView&lt;br&gt;不读整包 ProjectState" vertex="1">
          <mxGeometry height="118" width="250" x="1350" y="282" as="geometry" />
        </mxCell>
        <mxCell id="loop-plan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;规划&lt;/b&gt;&lt;br&gt;tool_model.choose_tool&lt;br&gt;只许选 allowed_tools&lt;br&gt;steps ≥ max_steps → 失败&lt;br&gt;不另开 Sub-Agent 类" vertex="1">
