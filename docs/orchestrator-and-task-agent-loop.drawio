        <mxCell id="loop-mem" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=12;" value="&lt;b&gt;Task Working Mem　任务级，提交即丢&lt;/b&gt;&lt;br&gt;messages[]　system 指令 + TaskEnvelope + 每步 tool/result/StateView&lt;br&gt;actions: ActionRecord[]　{action_id, agent, task_id, tool, result, reason, duration_ms, cost_usd}&lt;br&gt;candidate　阶段 schema　→ GenericAgentExecution{candidate, result: AgentResult}&lt;br&gt;AgentResult：status / state_version_used / input_hash / artifact_refs[] / state_patch / evaluation_target / error" vertex="1">
