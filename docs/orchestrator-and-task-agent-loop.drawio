        <mxCell id="loop-fb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;反馈&lt;/b&gt;&lt;br&gt;成功：结果进 messages&lt;br&gt;失败：错误原样返回&lt;br&gt;board.apply_tool_result&lt;br&gt;submit → 解析 candidate" vertex="1">
          <mxGeometry height="118" width="272" x="2148" y="282" as="geometry" />
