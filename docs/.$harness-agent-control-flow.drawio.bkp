<mxfile host="app.diagrams.net" modified="2026-08-12T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="harness-run" name="Harness通用视频生产流程">
    <mxGraphModel dx="5200" dy="3200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5200" pageHeight="3200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;Harness 控制的一次通用视频生产流程&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;Agent 是黑盒；主线展示 Harness 如何把 TaskEnvelope 与领域输入交给 Agent，并对候选产物验收、提交和路由&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="25" width="5040" height="75" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;箭头颜色：&lt;/b&gt;　蓝色＝Harness 调度 / TaskEnvelope　绿色＝候选或正式产物　紫色＝Critic 验收　红色＝返修　橙色＝Format 路由　所有箭头均为实线" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=15;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=13;" vertex="1" parent="1"><mxGeometry x="70" y="110" width="5040" height="55" as="geometry"/></mxCell>

        <mxCell id="task-ref" value="&lt;b&gt;TaskEnvelope 类属性（旁置参考，不参与流程）&lt;/b&gt;&lt;br&gt;&lt;br&gt;task_id: str&lt;br&gt;agent: str&lt;br&gt;goal: str&lt;br&gt;scope: TaskScope&lt;br&gt;based_on_state_version: int&lt;br&gt;format_id: str | null&lt;br&gt;agent_instructions: str | null&lt;br&gt;allowed_tools: list[str]&lt;br&gt;required_outputs: list[str]&lt;br&gt;forbidden_actions: list[str]&lt;br&gt;acceptance_criteria: list[str]&lt;br&gt;budget: TaskBudget&lt;br&gt;input_hash: str&lt;br&gt;dependency_snapshot: list[DependencySnapshot]&lt;br&gt;&lt;br&gt;&lt;b&gt;TaskScope&lt;/b&gt;&lt;br&gt;project_id / shot_ids / section_ids / beat_ids&lt;br&gt;script_segment_ids / visual_request_ids / asset_ids / target_refs&lt;br&gt;&lt;br&gt;&lt;b&gt;TaskBudget&lt;/b&gt;&lt;br&gt;max_steps / max_retries / max_cost_usd&lt;br&gt;deadline_seconds / fallback_policy&lt;br&gt;&lt;br&gt;&lt;b&gt;DependencySnapshot&lt;/b&gt;&lt;br&gt;ref / version / content_hash" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="610" height="650" as="geometry"/></mxCell>
        <mxCell id="result-ref" value="&lt;b&gt;AgentResult 类属性（旁置参考）&lt;/b&gt;&lt;br&gt;task_id / status / state_version_used / input_hash&lt;br&gt;actions[] / artifact_refs[] / state_patch&lt;br&gt;evaluation_target / error?&lt;br&gt;&lt;br&gt;&lt;b&gt;注意：&lt;/b&gt;AgentResult 和 StatePatch 只是执行报告与状态修改建议；正式状态只能由 Harness Commit。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="900" width="610" height="225" as="geometry"/></mxCell>
        <mxCell id="harness-rules" value="&lt;b&gt;Harness 在每个 Agent 前后执行的固定控制&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;调用前&lt;/b&gt;&lt;br&gt;1. 从正式 ProjectState 读取 state_version 和阶段 status&lt;br&gt;2. 读取上游已提交 Artifact&lt;br&gt;3. 创建本阶段 TaskEnvelope&lt;br&gt;4. 校验 project_id / input_hash / dependency snapshot&lt;br&gt;5. 校验 based_on_state_version 未过期&lt;br&gt;6. 限制 allowed_tools、scope、budget 和 required_outputs&lt;br&gt;&lt;br&gt;&lt;b&gt;调用后&lt;/b&gt;&lt;br&gt;7. 校验 AgentResult 与候选 Artifact Schema&lt;br&gt;8. 独立 Critic 输出 EvaluationResult&lt;br&gt;9. passed 才构造正式 Artifact 并 Commit&lt;br&gt;10. state_version +1，更新阶段 status&lt;br&gt;11. 更新 DependencyGraph 与 Trajectory&lt;br&gt;12. 失败则生成 revision / repair TaskEnvelope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="1160" width="610" height="570" as="geometry"/></mxCell>
        <mxCell id="state" value="&lt;b&gt;正式状态与产物仓库&lt;/b&gt;&lt;br&gt;ProjectState{runtime_context,world_state,video_profile,video,dependency_graph,trajectory}&lt;br&gt;Artifact JSON / media files / run records" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="1780" width="570" height="190" as="geometry"/></mxCell>

        <mxCell id="request" value="&lt;b&gt;视频需求输入&lt;/b&gt;&lt;br&gt;CreativeBrief{&lt;br&gt;project_id, project_name?, topic,&lt;br&gt;target, audience, communication,&lt;br&gt;production_mode: auto|explainer|drama|tutorial,&lt;br&gt;video_profile, content_policy&lt;br&gt;}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="225" width="650" height="225" as="geometry"/></mxCell>
        <mxCell id="n-harness" value="&lt;b&gt;Narrative Harness Controller&lt;/b&gt;&lt;br&gt;解析 production_mode → FormatPack&lt;br&gt;创建 Narrative TaskEnvelope&lt;br&gt;校验 brief / format / state_version / input_hash&lt;br&gt;启动 stdio MCP Server 并调用 Agent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1570" y="235" width="600" height="205" as="geometry"/></mxCell>
        <mxCell id="n-agent" value="&lt;b&gt;Narrative Agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2280" y="290" width="340" height="95" as="geometry"/></mxCell>
        <mxCell id="n-out" value="&lt;b&gt;NarrativeCandidate / NarrativeArtifact 字段&lt;/b&gt;&lt;br&gt;schema_version / generated_at / model&lt;br&gt;brief: CreativeBrief&lt;br&gt;planning: PlanningArtifact | DramaPlanningArtifact | TutorialPlanningArtifact&lt;br&gt;script?: ScriptArtifact | TutorialScriptArtifact&lt;br&gt;shots?: ShotPlanArtifact&lt;br&gt;quality: QualityReport&lt;br&gt;&lt;br&gt;ProductionShot{shot_id,order,shot_kind,purpose,source_refs,world_state_before_ref?,world_state_after_ref?,visual,audio,timing,payload}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2740" y="210" width="800" height="260" as="geometry"/></mxCell>
        <mxCell id="n-review" value="&lt;b&gt;Harness 验收与 Commit&lt;/b&gt;&lt;br&gt;校验 AgentResult / required_outputs / planning_schema&lt;br&gt;Narrative Critic → EvaluationResult{passed,issues[]}&lt;br&gt;passed：提交 NarrativeArtifact、world_state、video_profile&lt;br&gt;失败：构造 revision/repair TaskEnvelope 返回 Narrative Agent" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3650" y="225" width="680" height="230" as="geometry"/></mxCell>
        <mxCell id="format-route" value="&lt;b&gt;Harness ProductionRoute&lt;/b&gt;&lt;br&gt;读取已提交 shots[]，不采用 Agent 自报路线&lt;br&gt;所有 shot_kind 必须一致&lt;br&gt;explainer → editorial_assets&lt;br&gt;drama/tutorial → shot_ai_video&lt;br&gt;并验证 visual.realization_type / audio.audio_mode" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#9A3412;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="4470" y="205" width="600" height="270" as="geometry"/></mxCell>

        <mxCell id="voice-in" value="&lt;b&gt;Voice Agent 领域输入&lt;/b&gt;&lt;br&gt;NarrativeArtifact{brief,planning,script,shots?,quality}&lt;br&gt;project_dir / voice_id / TTS provider&lt;br&gt;ProjectState{state_version,voice_status}&lt;br&gt;&lt;b&gt;Harness 另传：TaskEnvelope&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4310" y="650" width="650" height="190" as="geometry"/></mxCell>
        <mxCell id="voice-h" value="&lt;b&gt;Voice Harness Controller&lt;/b&gt;&lt;br&gt;检查 voice_status / state_version&lt;br&gt;计算 Narrative input_hash&lt;br&gt;创建 TaskEnvelope，限制 Voice tools&lt;br&gt;调用后校验 AgentResult" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3590" y="660" width="600" height="170" as="geometry"/></mxCell>
        <mxCell id="voice-agent" value="&lt;b&gt;Voice Agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3150" y="700" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="voice-out" value="&lt;b&gt;VoiceArtifact 字段&lt;/b&gt;&lt;br&gt;schema_version / generated_at / project_id / source_narrative&lt;br&gt;voice_plan: VoicePlan&lt;br&gt;timed_audio: TimedAudio&lt;br&gt;word_alignment: WordAlignment&lt;br&gt;realized_beats: RealizedBeat[]&lt;br&gt;quality: VoiceQuality{passed,audio_exists,audio_duration_ms,segment_coverage,word_alignment_coverage,realized_beat_coverage,issues[]}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2250" y="630" width="790" height="235" as="geometry"/></mxCell>
        <mxCell id="voice-review" value="&lt;b&gt;Voice Critic + Harness Commit&lt;/b&gt;&lt;br&gt;检查音频存在、Segment/Beat 覆盖、时间戳&lt;br&gt;passed → VoiceArtifact 正式提交&lt;br&gt;更新 voice_status / editorial_status / state_version&lt;br&gt;更新 DependencyGraph / Transition / Trajectory&lt;br&gt;failed → Voice revision TaskEnvelope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1480" y="650" width="660" height="195" as="geometry"/></mxCell>

        <mxCell id="ed-in" value="&lt;b&gt;Editorial Agent 领域输入&lt;/b&gt;&lt;br&gt;NarrativeArtifact + VoiceArtifact&lt;br&gt;ProjectState{world_state,video_profile,state_version,editorial_status}&lt;br&gt;current_artifact?: EditorialArtifact&lt;br&gt;critic_problems?: string[] / feedback?&lt;br&gt;&lt;b&gt;Harness 另传：TaskEnvelope&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="1040" width="680" height="205" as="geometry"/></mxCell>
        <mxCell id="ed-h" value="&lt;b&gt;Editorial Harness Controller&lt;/b&gt;&lt;br&gt;校验 Narrative + Voice 依赖 current&lt;br&gt;创建 TaskEnvelope，限定 editorial scope/tools&lt;br&gt;注入 feedback/current artifact&lt;br&gt;调用后校验输出与 StatePatch" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1600" y="1055" width="610" height="175" as="geometry"/></mxCell>
        <mxCell id="ed-agent" value="&lt;b&gt;Editorial Agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2320" y="1095" width="340" height="95" as="geometry"/></mxCell>
        <mxCell id="ed-out" value="&lt;b&gt;EditorialArtifact 字段&lt;/b&gt;&lt;br&gt;schema_version / generated_at / model / project_id&lt;br&gt;source_narrative / source_voice&lt;br&gt;editorial_plan: EditorialPlan{plan_version,project_id,video_profile,claims: ClaimRecord[],visual_requirements: VisualRequirement[]}&lt;br&gt;quality: EditorialQuality{passed,beat_visual_coverage,claim_count,factual_claim_count,interpretation_count,speaker_presence_ratio,issues[]}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2770" y="1015" width="850" height="255" as="geometry"/></mxCell>
        <mxCell id="ed-review" value="&lt;b&gt;Editorial Critic + Harness Commit&lt;/b&gt;&lt;br&gt;检查 Beat→VisualRequirement 覆盖、Claim/source、video_profile&lt;br&gt;passed → 提交 EditorialArtifact&lt;br&gt;更新 editorial_status / asset_status / state_version&lt;br&gt;更新依赖图和执行轨迹&lt;br&gt;failed → 带 issues/current artifact 的 revision TaskEnvelope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3730" y="1035" width="700" height="215" as="geometry"/></mxCell>

        <mxCell id="asset-in" value="&lt;b&gt;Asset Agent 领域输入（explainer）&lt;/b&gt;&lt;br&gt;EditorialArtifact + VoiceArtifact&lt;br&gt;project_dir / RoutedAssetProvider / ImageAnalyzer&lt;br&gt;ProjectState{state_version,asset_status}&lt;br&gt;current_artifact?: AssetArtifact&lt;br&gt;&lt;b&gt;Harness 另传：TaskEnvelope&lt;/b&gt;，可把 visual_request_ids / asset_ids / target_refs 限定为局部 scope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4320" y="1400" width="700" height="220" as="geometry"/></mxCell>
        <mxCell id="asset-h" value="&lt;b&gt;Asset Harness Controller&lt;/b&gt;&lt;br&gt;计算 Editorial + Voice input_hash&lt;br&gt;验证依赖与 asset_status&lt;br&gt;创建 generation / revision / repair TaskEnvelope&lt;br&gt;局部修复时禁止 scope 外 semantic hash 改变" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3600" y="1415" width="610" height="190" as="geometry"/></mxCell>
        <mxCell id="asset-agent" value="&lt;b&gt;Asset Agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3160" y="1465" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="asset-out" value="&lt;b&gt;AssetArtifact 字段&lt;/b&gt;&lt;br&gt;schema_version / generated_at / project_id / source_editorial&lt;br&gt;assets: AssetCard[]&lt;br&gt;resolutions: VisualResolution[]&lt;br&gt;inspections: AssetInspection[]&lt;br&gt;prepared_images: PreparedImage[]&lt;br&gt;quality: AssetQuality{passed,visual_request_count,resolved_count,unresolved_count,resolution_coverage,first_success_violations,inspection/preparation counts,issues[]}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2240" y="1375" width="810" height="260" as="geometry"/></mxCell>
        <mxCell id="asset-review" value="&lt;b&gt;Asset Critic + Harness Commit&lt;/b&gt;&lt;br&gt;检查覆盖、文件、MIME、图像准备状态&lt;br&gt;passed → 提交 AssetArtifact，激活 Timeline&lt;br&gt;局部 repair → select_repair_commits 只提交 target_refs&lt;br&gt;DependencyGraph 将变化的下游标为 stale&lt;br&gt;failed → Asset revision/repair TaskEnvelope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1460" y="1400" width="670" height="220" as="geometry"/></mxCell>

        <mxCell id="tl-in" value="&lt;b&gt;Timeline Agent 领域输入（explainer）&lt;/b&gt;&lt;br&gt;VoiceArtifact + EditorialArtifact + AssetArtifact&lt;br&gt;project_dir / ScreenAnimationProvider&lt;br&gt;ProjectState{state_version,timeline_status}&lt;br&gt;current_artifact?: TimelineArtifact&lt;br&gt;&lt;b&gt;Harness 另传：TaskEnvelope&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="1785" width="680" height="205" as="geometry"/></mxCell>
        <mxCell id="tl-h" value="&lt;b&gt;Timeline Harness Controller&lt;/b&gt;&lt;br&gt;验证 Voice/Editorial/Asset 全部 current&lt;br&gt;创建 audio-clocked Timeline TaskEnvelope&lt;br&gt;校验媒体存在、input_hash、state_version&lt;br&gt;调用后检查 AgentResult" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1600" y="1800" width="610" height="175" as="geometry"/></mxCell>
        <mxCell id="tl-agent" value="&lt;b&gt;Timeline Agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2320" y="1840" width="340" height="95" as="geometry"/></mxCell>
        <mxCell id="tl-out" value="&lt;b&gt;TimelineArtifact 字段&lt;/b&gt;&lt;br&gt;schema_version / generated_at / project_id&lt;br&gt;source_voice / source_editorial / source_assets&lt;br&gt;derivatives: DerivedAsset[]&lt;br&gt;timeline: TimelinePlan{canvas_width,canvas_height,fps,audio_file,duration_ms,clips[]}&lt;br&gt;captions: CaptionCue[] / visual_transforms: VisualTransform[] / overlays: OverlayCue[]&lt;br&gt;quality: TimelineQuality{passed,beat_count,clip_count,caption_cue_count,full_audio_coverage,missing_asset_count,issues[]}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2770" y="1755" width="880" height="265" as="geometry"/></mxCell>
        <mxCell id="tl-review" value="&lt;b&gt;Timeline Critic + Harness Commit&lt;/b&gt;&lt;br&gt;检查从 0 开始、clips 连续、完整音频覆盖、媒体存在&lt;br&gt;passed → 提交 TimelineArtifact&lt;br&gt;更新 timeline_status / render_status / state_version&lt;br&gt;写 DependencyGraph / Transition / Trajectory&lt;br&gt;failed → Timeline revision TaskEnvelope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3760" y="1780" width="700" height="220" as="geometry"/></mxCell>

        <mxCell id="render-in" value="&lt;b&gt;Render Agent 领域输入（explainer）&lt;/b&gt;&lt;br&gt;VoiceArtifact + TimelineArtifact&lt;br&gt;project_dir / RenderCapabilities&lt;br&gt;ProjectState{state_version,render_status}&lt;br&gt;所有 timeline media files&lt;br&gt;&lt;b&gt;Harness 另传：TaskEnvelope&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4330" y="2150" width="680" height="200" as="geometry"/></mxCell>
        <mxCell id="render-h" value="&lt;b&gt;Render Harness Controller&lt;/b&gt;&lt;br&gt;验证 timeline_status=passed / render_status=ready&lt;br&gt;创建 Render TaskEnvelope&lt;br&gt;校验 input_hash、state_version、媒体文件&lt;br&gt;调用后检查 RenderCandidate / AgentResult" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3600" y="2165" width="620" height="175" as="geometry"/></mxCell>
        <mxCell id="render-agent" value="&lt;b&gt;Render Agent&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3160" y="2205" width="330" height="95" as="geometry"/></mxCell>
        <mxCell id="render-out" value="&lt;b&gt;RenderArtifact 字段&lt;/b&gt;&lt;br&gt;schema_version / generated_at / project_id&lt;br&gt;source_voice? / source_timeline&lt;br&gt;composition: RenderComposition{renderer_version,duration_ms,duration_in_frames,audio_path?,clips[],captions[],overlays[]}&lt;br&gt;outputs: RenderedMedia[]&lt;br&gt;quality: RenderQuality{passed,expected_duration_ms,actual_duration_ms,duration_delta_ms,resolution_correct,fps_correct,audio_present,video_present,full_timeline_coverage,missing_media_count,issues[]}" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2220" y="2115" width="830" height="275" as="geometry"/></mxCell>
        <mxCell id="render-review" value="&lt;b&gt;Render Critic + Harness 最终 Commit&lt;/b&gt;&lt;br&gt;检查 duration / resolution / fps / audio / video / timeline coverage&lt;br&gt;passed → 提交 RenderArtifact 和 MP4 outputs&lt;br&gt;render_status=passed，Transition → project_complete&lt;br&gt;更新 state_version / DependencyGraph / Trajectory&lt;br&gt;failed → Render revision TaskEnvelope" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=11;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="2140" width="680" height="225" as="geometry"/></mxCell>
        <mxCell id="complete" value="&lt;b&gt;正式输出&lt;/b&gt;&lt;br&gt;RenderArtifact&lt;br&gt;video/final.mp4&lt;br&gt;video/preview.mp4&lt;br&gt;project_state.json&lt;br&gt;Task / AgentResult / Evaluation / Transition / GraphUpdate records&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;project_complete&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#DCFCE7;strokeColor=#15803D;strokeWidth=2;fontColor=#166534;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="2135" width="520" height="235" as="geometry"/></mxCell>

        <mxCell id="shot-route" value="&lt;b&gt;Drama / Tutorial 的另一条 Harness 路线&lt;/b&gt;&lt;br&gt;输入仍来自正式 NarrativeArtifact.shots[]&lt;br&gt;Shot Asset Harness Stage → ShotAssetArtifact{format_id,assets: ShotVideoAsset[],quality}&lt;br&gt;Shot Timeline Harness Stage → ShotTimelineArtifact{duration_ms,clips: ShotTimelineClip[]}&lt;br&gt;Shot Render Harness Stage → RenderArtifact{source_voice=null,composition,outputs,quality}&lt;br&gt;这三个阶段当前是 Harness 确定性 Stage，不画成 Agent；保留 AI Video 原生/混合音频。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="2535" width="1640" height="255" as="geometry"/></mxCell>
        <mxCell id="repair" value="&lt;b&gt;统一返修回路&lt;/b&gt;&lt;br&gt;任意 Critic passed=false → issues[] + target_ref → Harness/RepairPlanner&lt;br&gt;从 DependencyGraph 查 stale ancestors 和 produced_by → 生成局部 TaskScope.target_refs&lt;br&gt;dependency_snapshot + target_refs → repair_input_hash&lt;br&gt;新 TaskEnvelope 再传给对应 Agent；select_repair_commits 拒绝 scope 外变化&lt;br&gt;返修仍必须重新通过 AgentResult 校验、Critic 和正式 Commit。" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=13;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontColor=#991B1B;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2580" y="2535" width="1670" height="255" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;b&gt;控制边界：&lt;/b&gt;Agent 负责在 TaskEnvelope 允许范围内生成候选；Harness 负责选择 Agent、组织领域输入、控制工具和预算、验证结果、调用 Critic、提交正式状态、决定下一阶段与返修范围。" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="2920" width="4200" height="100" as="geometry"/></mxCell>

