<mxfile host="Electron" agent="Cursor">
  <diagram id="video-repair-project-state" name="视频修改流程与 ProjectState v3">
    <mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="2100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#172033;fontStyle=1;" value="视频修改流程与 ProjectState v3&lt;br&gt;&lt;font color=&quot;#5E687A&quot; style=&quot;font-size:13px;&quot;&gt;感知层只定点；Harness 弄脏子图再拉制作 agent。账本拆成 context / creative / production / evaluation / dependency_graph / trajectory。&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="2400" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#F7F8FA;strokeColor=#DDE2EA;fontSize=13;fontColor=#172033;" value="&lt;b&gt;图例&lt;/b&gt;　深蓝＝用户　玫红＝感知层　橙＝两条入口　蓝＝Harness 执行　绿＝写回账本　灰＝只读 / dry-run" vertex="1">
          <mxGeometry height="40" width="2400" x="40" y="76" as="geometry" />
        </mxCell>

        <mxCell id="flow" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontStyle=1;fontSize=16;" value="修改主路径　用户改口 → 定点 → 弄脏子图 → 循环修到 current" vertex="1">
          <mxGeometry height="280" width="2400" x="40" y="132" as="geometry" />
        </mxCell>
        <mxCell id="f0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" value="&lt;b&gt;用户改口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;第三段太长&lt;br&gt;收成两句&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="170" x="60" y="198" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE7F3;strokeColor=#DB2777;fontSize=12;" value="&lt;b&gt;1　读图定点&lt;/b&gt;&lt;br&gt;inspect-graph / revise-segment&lt;br&gt;list_graph 无参看根&lt;br&gt;around_ref 看一跳&lt;br&gt;交出 target_refs + instruction" vertex="1">
          <mxGeometry height="160" width="250" x="260" y="198" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;" value="&lt;b&gt;2　解析别名&lt;/b&gt;&lt;br&gt;planned_beat:b3 → beat:b3&lt;br&gt;节点不存在 → 失败&lt;br&gt;不手工加 dependents" vertex="1">
          <mxGeometry height="160" width="230" x="540" y="198" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" value="&lt;b&gt;3　invalidate_subgraph&lt;/b&gt;&lt;br&gt;种子 + 全部 dependents → stale&lt;br&gt;任意 locked → 整团失败&lt;br&gt;desired = 被弄脏的那一组" vertex="1">
          <mxGeometry height="160" width="280" x="800" y="198" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontSize=12;" value="&lt;b&gt;4　drive_repair 循环&lt;/b&gt;&lt;br&gt;plan 可跑前沿&lt;br&gt;StageRunner.run(task, feedback)&lt;br&gt;直到 desired 都 current&lt;br&gt;最多 12 轮" vertex="1">
          <mxGeometry height="160" width="270" x="1110" y="198" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DCFCE7;strokeColor=#2E9B72;fontSize=12;" value="&lt;b&gt;5　写回账本&lt;/b&gt;&lt;br&gt;production 改字&lt;br&gt;图节点 current&lt;br&gt;evaluation.stages 更新&lt;br&gt;trajectory 记一条 repair" vertex="1">
          <mxGeometry height="160" width="250" x="1410" y="198" as="geometry" />
        </mxCell>
        <mxCell id="f6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" value="&lt;b&gt;用户看到&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;已经派去改短&lt;br&gt;或 dry-run 预览&lt;/font&gt;" vertex="1">
          <mxGeometry height="160" width="170" x="1690" y="198" as="geometry" />
        </mxCell>
        <mxCell id="f-dry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;dashed=1;dashPattern=8 8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#5E687A;fontSize=12;" value="&lt;b&gt;dry-run / 测试&lt;/b&gt;&lt;br&gt;停在第 3 步预览&lt;br&gt;不写盘、不拉 LLM&lt;br&gt;返回 invalidated + planned_tasks" vertex="1">
          <mxGeometry height="160" width="250" x="1900" y="198" as="geometry" />
        </mxCell>

        <mxCell id="e0" parent="1" style="endArrow=block;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" source="f0" target="f1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" style="endArrow=block;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" source="f1" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" parent="1" style="endArrow=block;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" source="f2" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" parent="1" style="endArrow=block;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" source="f3" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" parent="1" style="endArrow=block;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" source="f4" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" parent="1" style="endArrow=block;html=1;strokeColor=#334155;strokeWidth=2;" edge="1" source="f5" target="f6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" parent="1" style="endArrow=open;dashed=1;html=1;strokeColor=#94A3B8;" edge="1" source="f3" target="f-dry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="ports" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontColor=#9A3412;fontStyle=1;fontSize=16;" value="两条入口汇到同一条 drive_repair　desired = 被弄脏的整团，不是用户点的那一个" vertex="1">
          <mxGeometry height="280" width="2400" x="40" y="432" as="geometry" />
        </mxCell>
        <mxCell id="p-in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=12;" value="&lt;b&gt;Intake　harness.repair&lt;/b&gt;&lt;br&gt;感知层只填 target_refs[] + instruction&lt;br&gt;不选 agent、不加 dependents&lt;br&gt;非 dry-run：MCP 注入 run_repair_task → StageRunner&lt;br&gt;代码：intake/actions.repair_description" vertex="1">
          <mxGeometry height="200" width="740" x="60" y="492" as="geometry" />
        </mxCell>
        <mxCell id="p-st" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#EA580C;fontSize=12;" value="&lt;b&gt;Studio　RepairService.run&lt;/b&gt;&lt;br&gt;POST /api/projects/{key}/repairs/{feedback_id}&lt;br&gt;feedback.target_ref → resolve_graph_ref&lt;br&gt;同样 invalidate → drive_repair&lt;br&gt;feedback：open → repairing → resolved（失败回 open）" vertex="1">
          <mxGeometry height="200" width="740" x="830" y="492" as="geometry" />
        </mxCell>
        <mxCell id="p-loop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" value="&lt;b&gt;共用循环　drive_repair&lt;/b&gt;&lt;br&gt;plan(state, desired) → 按 produced_by 组 TaskEnvelope&lt;br&gt;run_task(task, instruction) → *HarnessController.run(task)&lt;br&gt;commit 后下一轮；complete / blocker / 12 轮上限&lt;br&gt;instruction 作为 feedback 注入制作 agent" vertex="1">
          <mxGeometry height="200" width="800" x="1600" y="492" as="geometry" />
        </mxCell>

        <mxCell id="state" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#F8FAFC;strokeColor=#334155;strokeWidth=2;fontColor=#0F172A;fontStyle=1;fontSize=16;" value="ProjectState v3　顶层六块（v2 的 video / description / execution / runtime_context 只作读旧文件别名）" vertex="1">
          <mxGeometry height="560" width="2400" x="40" y="732" as="geometry" />
        </mxCell>
        <mxCell id="s-ctx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;" value="&lt;b&gt;context&lt;/b&gt;&lt;br&gt;project_id&lt;br&gt;state_version&lt;br&gt;available_models / tools&lt;br&gt;constraints&lt;br&gt;&lt;font color=&quot;#5E687A&quot;&gt;来自 video + runtime_context&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="60" y="792" as="geometry" />
        </mxCell>
        <mxCell id="s-cre" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" value="&lt;b&gt;creative&lt;/b&gt;&lt;br&gt;brief：开工任务书&lt;br&gt;intent：topic / promise / audience / target / format_id&lt;br&gt;&lt;font color=&quot;#5E687A&quot;&gt;改片默认不动&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="450" y="792" as="geometry" />
        </mxCell>
        <mxCell id="s-pro" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DCFCE7;strokeColor=#2E9B72;strokeWidth=2;fontSize=12;" value="&lt;b&gt;production　改字写这里&lt;/b&gt;&lt;br&gt;world：cast / props / places / claims&lt;br&gt;structure：beats | scenes | steps&lt;br&gt;voice：utterances + 音频绑定&lt;br&gt;shots[] / timeline / deliverable&lt;br&gt;&lt;font color=&quot;#166534&quot;&gt;已去掉 visual_language、sound_design、world.state&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="420" x="840" y="792" as="geometry" />
        </mxCell>
        <mxCell id="s-eva" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;" value="&lt;b&gt;evaluation&lt;/b&gt;&lt;br&gt;elements[ref]：status / version / attempts / error&lt;br&gt;stages：narrative / script / voice / editorial / asset / timeline / render&lt;br&gt;&lt;font color=&quot;#5E687A&quot;&gt;来自 execution + video.*_status&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="400" x="1290" y="792" as="geometry" />
        </mxCell>
        <mxCell id="s-g" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;" value="&lt;b&gt;dependency_graph&lt;/b&gt;&lt;br&gt;7 种节点：cast / prop / place&lt;br&gt;beat|scene|step　utterance　audio　shot&lt;br&gt;3 种边：plot / identity / voice&lt;br&gt;节点：status current|stale、locked、produced_by&lt;br&gt;&lt;font color=&quot;#9A3412&quot;&gt;section / action / clip 不进图&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="340" x="1720" y="792" as="geometry" />
        </mxCell>
        <mxCell id="s-tr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;" value="&lt;b&gt;trajectory&lt;/b&gt;&lt;br&gt;phases[phase].tasks[]&lt;br&gt;task_kind = repair&lt;br&gt;记下 envelope / critic / graph_update" vertex="1">
          <mxGeometry height="200" width="330" x="2090" y="792" as="geometry" />
        </mxCell>

        <mxCell id="mut" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#334155;fontSize=12;" value="&lt;b&gt;修一轮谁被改&lt;/b&gt;　invalidate 只把图节点标 stale，正文先不动。commit 时：narrative 写 structure / world / utterances；voice 写 audio 绑定；editorial 写 shots。context.state_version 与 graph_version 递增。creative 通常不动。" vertex="1">
          <mxGeometry height="80" width="2360" x="60" y="1016" as="geometry" />
        </mxCell>
        <mxCell id="gone" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" value="&lt;b&gt;相对 v2 拿掉 / 搬家&lt;/b&gt;　video.*_status → evaluation.stages　　description 整本拆成 creative.intent + production　　execution → evaluation.elements　　runtime_context → context　　visual_language / sound_design 不再落账本" vertex="1">
          <mxGeometry height="80" width="2360" x="60" y="1112" as="geometry" />
        </mxCell>

        <mxCell id="pick" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#EAF0FF;strokeColor=#356AE6;strokeWidth=2;fontColor=#1E3A8A;fontStyle=1;fontSize=16;" value="点哪一层，先弄脏什么　感知层一次只圈一层，Harness 自己展开下游" vertex="1">
          <mxGeometry height="320" width="2400" x="40" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="k1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#356AE6;fontSize=12;" value="&lt;b&gt;改一段结构 / 长短&lt;/b&gt;&lt;br&gt;target：beat: / scene: / step:&lt;br&gt;弄脏：utterance + audio + shot&lt;br&gt;先跑 narrative_agent" vertex="1">
          <mxGeometry height="160" width="430" x="60" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="k2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#356AE6;fontSize=12;" value="&lt;b&gt;改一句台词&lt;/b&gt;&lt;br&gt;target：utterance:&lt;br&gt;弄脏：audio&lt;br&gt;narrative 改词 → voice 重配" vertex="1">
          <mxGeometry height="160" width="430" x="520" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="k3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#356AE6;fontSize=12;" value="&lt;b&gt;只重配 / 改镜头&lt;/b&gt;&lt;br&gt;audio: → 只跑 voice_agent&lt;br&gt;shot: → editorial_agent&lt;br&gt;再脏到 timeline / render（若已建）" vertex="1">
          <mxGeometry height="160" width="430" x="980" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="k4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#356AE6;fontSize=12;" value="&lt;b&gt;改出镜人 / 道具 / 场地&lt;/b&gt;&lt;br&gt;target：cast: / prop: / place:&lt;br&gt;弄脏：引用它们的 beat / shot&lt;br&gt;identity 边，不是 plot" vertex="1">
          <mxGeometry height="160" width="430" x="1440" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="k5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;" value="&lt;b&gt;不要点&lt;/b&gt;&lt;br&gt;section: / action: / clip:&lt;br&gt;只在 production 文档里&lt;br&gt;locked=true 不要 repair" vertex="1">
          <mxGeometry height="160" width="430" x="1900" y="1280" as="geometry" />
        </mxCell>
        <mxCell id="k-note" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5E687A;" value="list_graph 无参只返回内容根（身份册 + 结构层）。around_ref 才带出 utterance / audio / shot。一次 target_refs 不要把 dependents 手工加进去。" vertex="1">
          <mxGeometry height="30" width="2360" x="60" y="1464" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
