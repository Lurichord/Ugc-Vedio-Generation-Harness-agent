        <mxCell id="s-tr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#111827;fontSize=12;" value="&lt;b&gt;trajectory&lt;/b&gt;&lt;br&gt;phases[phase].tasks[]&lt;br&gt;task_kind = repair&lt;br&gt;记下 envelope / critic / graph_update" vertex="1">
          <mxGeometry height="200" width="330" x="2090" y="792" as="geometry" />
