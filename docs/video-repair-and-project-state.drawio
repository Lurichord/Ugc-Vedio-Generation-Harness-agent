        <mxCell id="flow" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#111827;fontStyle=1;fontSize=16;" value="修改主路径　用户改口 → 定点 → 弄脏子图 → 循环修到 current" vertex="1">
          <mxGeometry height="280" width="2400" x="40" y="132" as="geometry" />
        </mxCell>
        <mxCell id="f0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#111827;fontSize=13;fontStyle=1;" value="&lt;b&gt;用户改口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;第三段太长&lt;br&gt;收成两句&lt;/font&gt;" vertex="1">
