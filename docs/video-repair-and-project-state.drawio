        <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#111827;fontSize=12;" value="&lt;b&gt;1　读图定点&lt;/b&gt;&lt;br&gt;inspect-graph / revise-segment&lt;br&gt;list_graph 无参看根&lt;br&gt;around_ref 看一跳&lt;br&gt;交出 target_refs + instruction" vertex="1">
          <mxGeometry height="160" width="250" x="260" y="198" as="geometry" />
