        <mxCell id="s-cre" parent="state" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#111827;fontSize=12;" value="&lt;b&gt;creative&lt;/b&gt;&lt;br&gt;brief：开工任务书&lt;br&gt;intent：topic / promise / audience / target / format_id" vertex="1">
