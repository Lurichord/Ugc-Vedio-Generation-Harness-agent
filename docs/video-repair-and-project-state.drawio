        <mxCell id="p-in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#111827;fontSize=12;" value="&lt;b&gt;Intake　harness.repair&lt;/b&gt;&lt;br&gt;感知层只填 target_refs[] + instruction&lt;br&gt;不选 agent、不加 dependents&lt;br&gt;非 dry-run：MCP 注入 run_repair_task → StageRunner&lt;br&gt;代码：intake/actions.repair_description" vertex="1">
          <mxGeometry height="200" width="740" x="60" y="492" as="geometry" />
        </mxCell>
        <mxCell id="p-st" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#111827;fontSize=12;" value="&lt;b&gt;Studio　RepairService.run&lt;/b&gt;&lt;br&gt;POST /api/projects/{key}/repairs/{feedback_id}&lt;br&gt;feedback.target_ref → resolve_graph_ref&lt;br&gt;同样 invalidate → drive_repair&lt;br&gt;feedback：open → repairing → resolved（失败回 open）" vertex="1">
          <mxGeometry height="200" width="740" x="830" y="492" as="geometry" />
        </mxCell>
        <mxCell id="p-loop" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#334155;fontColor=#111827;fontSize=12;" value="&lt;b&gt;共用循环　drive_repair&lt;/b&gt;&lt;br&gt;plan(state, desired) → 按 produced_by 组 TaskEnvelope&lt;br&gt;run_task(task, instruction) → *HarnessController.run(task)&lt;br&gt;commit 后下一轮；complete / blocker / 12 轮上限&lt;br&gt;instruction 作为 feedback 注入制作 agent" vertex="1">
          <mxGeometry height="200" width="800" x="1600" y="492" as="geometry" />
        </mxCell>
        <mxCell id="state" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#111827;fontStyle=1;fontSize=16;" value="ProjectState v3　顶层六块" vertex="1">
          <mxGeometry height="560" width="2400" x="40" y="732" as="geometry" />
