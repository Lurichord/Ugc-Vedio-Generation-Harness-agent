        <mxCell id="ports" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;fontColor=#111827;fontStyle=1;fontSize=16;" value="&amp;nbsp;drive_repair　" vertex="1">
