          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-h3-h4" edge="1" parent="1" source="h3" target="h4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#E11D48;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-h4-inner" edge="1" parent="1" source="h4" target="a0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#DB2777;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1085" y="370" />
              <mxPoint x="200" y="370" />
              <mxPoint x="200" y="492" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e-h5-u" edge="1" parent="1" source="h5" target="u-out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#2E9B72;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1430" y="273" />
              <mxPoint x="2250" y="273" />
            </Array>
