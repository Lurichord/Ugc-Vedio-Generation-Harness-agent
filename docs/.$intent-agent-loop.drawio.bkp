<mxfile host="Electron" agent="Cursor">
  <diagram id="intent-agent-loop" name="感知层 Agent Loop 与 Harness 交互">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2480" pageHeight="1760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#172033;fontStyle=1;" value="感知层工作流：用户驱动外循环 · 工具驱动内循环 · 只通过意图 MCP 启用 Harness&lt;br&gt;&lt;font color=&quot;#5E687A&quot; style=&quot;font-size:13px;&quot;&gt;对应代码：IntentHost.respond → IntentAgent.run_until_yield（最多 8 拍）→ ugc-intake MCP。感知层不组 TaskEnvelope，也不直接调用 GenericAgent。&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="2400" x="40" y="16" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#F7F8FA;strokeColor=#DDE2EA;fontSize=13;fontColor=#172033;" value="&lt;b&gt;图例&lt;/b&gt;　深蓝＝用户　玫红＝感知层（Host / Agent）　橙＝意图 MCP　蓝＝Harness 执行　绿＝对用户出口　灰虚线＝只读或未接线　Studio「可以继续」不进本图内循环" vertex="1">
          <mxGeometry height="40" width="2400" x="40" y="76" as="geometry" />
        </mxCell>

        <mxCell id="outer" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontStyle=1;fontSize=16;" value="外循环　IntentHost.respond　用户一句话跑一轮，出口永远是一句人话" vertex="1">
          <mxGeometry height="280" width="2400" x="40" y="132" as="geometry" />
        </mxCell>
        <mxCell id="u-in" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" value="&lt;b&gt;用户一句话&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;Inbound.text&lt;br&gt;CLI / Studio 聊天&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="180" x="60" y="198" as="geometry" />
        </mxCell>
        <mxCell id="h1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;1　记对白&lt;/b&gt;&lt;br&gt;append messages[]&lt;br&gt;role=user&lt;br&gt;完整历史落盘&lt;br&gt;模型默认只看最近 12 条" vertex="1">
          <mxGeometry height="150" width="210" x="270" y="198" as="geometry" />
        </mxCell>
        <mxCell id="h2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;2　Host 写 brief&lt;/b&gt;&lt;br&gt;brief_sync.apply&lt;br&gt;只抽用户明确说的字段&lt;br&gt;写入 working_brief&lt;br&gt;模型没有 brief.update" vertex="1">
          <mxGeometry height="150" width="220" x="500" y="198" as="geometry" />
        </mxCell>
        <mxCell id="h3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;3　刷新进度&lt;/b&gt;&lt;br&gt;refresh_session_from_disk&lt;br&gt;有 project_dir 才读&lt;br&gt;progress / working_intent&lt;br&gt;不把剧本注入模型" vertex="1">
          <mxGeometry height="150" width="210" x="740" y="198" as="geometry" />
        </mxCell>
        <mxCell id="h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE7F3;strokeColor=#DB2777;strokeWidth=2;fontSize=12;" value="&lt;b&gt;4　进入内循环&lt;/b&gt;&lt;br&gt;IntentAgent.run_until_yield&lt;br&gt;打开 ugc-intake MCP&lt;br&gt;最多 8 拍工具&lt;br&gt;见下方内循环" vertex="1">
          <mxGeometry height="150" width="230" x="970" y="198" as="geometry" />
        </mxCell>
        <mxCell id="h5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DCFCE7;strokeColor=#2E9B72;fontSize=12;" value="&lt;b&gt;5　交还给用户&lt;/b&gt;&lt;br&gt;append role=agent&lt;br&gt;HostResult.message&lt;br&gt;status=waiting_user&lt;br&gt;done=true 才收工" vertex="1">
          <mxGeometry height="150" width="210" x="1220" y="198" as="geometry" />
        </mxCell>
        <mxCell id="session" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;IntakeSession 本轮会动的字段&lt;/b&gt;&lt;br&gt;messages[] 追加　working_brief 覆盖写　project_dir / progress 开工或刷新后才有&lt;br&gt;&lt;font color=&quot;#5E687A&quot;&gt;不输出 TaskEnvelope。对用户可见只有一句 message。&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="470" x="1450" y="198" as="geometry" />
        </mxCell>
        <mxCell id="bypass" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;dashed=1;dashPattern=8 8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#5E687A;fontSize=12;" value="&lt;b&gt;Studio 旁路&lt;/b&gt;&lt;br&gt;「可以 / 继续」匹配门禁&lt;br&gt;continue_production&lt;br&gt;直接 StageRunner&lt;br&gt;不进感知 Agent" vertex="1">
          <mxGeometry height="150" width="200" x="1940" y="198" as="geometry" />
        </mxCell>
        <mxCell id="u-out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#111827;strokeColor=#000000;fontColor=#FFFFFF;fontSize=13;fontStyle=1;" value="&lt;b&gt;用户看到&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;&quot;&gt;一句中文&lt;br&gt;等待下一句&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="180" x="2160" y="198" as="geometry" />
        </mxCell>

        <mxCell id="inner" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=2;fontColor=#9F1239;fontStyle=1;fontSize=16;" value="内循环　IntentAgent._run　一拍一个 AgentDecision；有 tool 就调，没有 tool 就 yield" vertex="1">
          <mxGeometry height="470" width="2400" x="40" y="432" as="geometry" />
        </mxCell>
        <mxCell id="a0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;A0　注入上下文&lt;/b&gt;&lt;br&gt;system = agent.md&lt;br&gt;+ skill 目录（name/description）&lt;br&gt;+ memory JSON：&lt;br&gt;　working_brief / working_intent&lt;br&gt;　progress / project_dir&lt;br&gt;+ 最近 12 条对白&lt;br&gt;stdio 拉起 ugc-intake&lt;br&gt;configure_session(session_path)" vertex="1">
          <mxGeometry height="250" width="280" x="60" y="492" as="geometry" />
        </mxCell>
        <mxCell id="a1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FCE7F3;strokeColor=#DB2777;fontSize=12;" value="&lt;b&gt;A1　decide()&lt;/b&gt;&lt;br&gt;模型只产出四个字段：&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;tool&lt;/font&gt;　本拍工具名或 null&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;arguments&lt;/font&gt;　该工具参数&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;message&lt;/font&gt;　给用户的一句&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;done&lt;/font&gt;　是否整段收工&lt;br&gt;调工具时 message 必须空&lt;br&gt;对用户说话时 tool 必须 null" vertex="1">
          <mxGeometry height="250" width="280" x="360" y="492" as="geometry" />
        </mxCell>
        <mxCell id="a2" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EAF0FF;strokeColor=#356AE6;fontColor=#172033;fontSize=13;fontStyle=1;" value="&lt;b&gt;A2　tool 为空？&lt;/b&gt;" vertex="1">
          <mxGeometry height="140" width="220" x="680" y="547" as="geometry" />
        </mxCell>
        <mxCell id="a-yes" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DCFCE7;strokeColor=#2E9B72;fontSize=12;" value="&lt;b&gt;是 → yield&lt;/b&gt;&lt;br&gt;AgentYield.message&lt;br&gt;结束本轮内循环&lt;br&gt;回到外循环第 5 步&lt;br&gt;不问就不调工具" vertex="1">
          <mxGeometry height="150" width="200" x="950" y="492" as="geometry" />
        </mxCell>
        <mxCell id="a-no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;否 → 调一次工具&lt;/b&gt;&lt;br&gt;一拍只能一个工具&lt;br&gt;失败看返回 error&lt;br&gt;不要用同一参数重试&lt;br&gt;skill.activate 在 Host 截走&lt;br&gt;其余走意图 MCP" vertex="1">
          <mxGeometry height="150" width="230" x="950" y="662" as="geometry" />
        </mxCell>
        <mxCell id="a-skill" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;skill.activate&lt;/b&gt;&lt;br&gt;{name}&lt;br&gt;把 skills/*.md 读进对话&lt;br&gt;不等于办事&lt;br&gt;clarify-brief / start-project&lt;br&gt;revise-segment / user-revises&lt;br&gt;inspect-progress" vertex="1">
          <mxGeometry height="230" width="230" x="1210" y="502" as="geometry" />
        </mxCell>
        <mxCell id="a-mcp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;" value="&lt;b&gt;意图 MCP 工具&lt;/b&gt;&lt;br&gt;description.list_outline {}&lt;br&gt;description.get_element {ref}&lt;br&gt;harness.start_project {}&lt;br&gt;harness.inspect {}&lt;br&gt;harness.list_graph {around_ref?}&lt;br&gt;harness.repair {target_refs, instruction}&lt;br&gt;&lt;font color=&quot;#9A3412&quot;&gt;没有 narrative.*　没有 GenericAgent.run&lt;/font&gt;" vertex="1">
          <mxGeometry height="230" width="280" x="1460" y="502" as="geometry" />
        </mxCell>
        <mxCell id="a-fb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFFFFF;strokeColor=#E11D48;fontSize=12;" value="&lt;b&gt;A3　结果回灌&lt;/b&gt;&lt;br&gt;assistant：本拍 tool+arguments&lt;br&gt;user：工具 JSON 结果&lt;br&gt;若 MCP 写了 session，立刻 reload&lt;br&gt;回到 A1，直到 yield 或 8 拍用尽" vertex="1">
          <mxGeometry height="150" width="280" x="1760" y="542" as="geometry" />
        </mxCell>
        <mxCell id="a-cap" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FEF3C7;strokeColor=#E29A35;fontSize=12;" value="&lt;b&gt;步数用尽&lt;/b&gt;&lt;br&gt;MAX_STEPS=8&lt;br&gt;用最后一次工具结果当话&lt;br&gt;done=false　停下来问用户" vertex="1">
          <mxGeometry height="150" width="200" x="2060" y="542" as="geometry" />
        </mxCell>
        <mxCell id="a-note" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5E687A;" value="收字段：常 1 拍就 yield（tool=null）。开工：activate → start_project → yield。改段：activate → outline → list_graph → repair → yield。" vertex="1">
          <mxGeometry height="30" width="2200" x="60" y="856" as="geometry" />
        </mxCell>

        <mxCell id="hx" parent="1" style="swimlane;html=1;rounded=1;startSize=40;horizontal=1;fillColor=#EAF0FF;strokeColor=#356AE6;strokeWidth=2;fontColor=#1E3A8A;fontStyle=1;fontSize=16;" value="感知层如何启用 Harness　意图层只交「开工 / 改这些 ref」；Task 由 Harness 自己组" vertex="1">
          <mxGeometry height="760" width="2400" x="40" y="922" as="geometry" />
        </mxCell>

        <mxCell id="path-start" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#356AE6;strokeWidth=2;fontSize=12;" value="&lt;b&gt;路径 1　开工　harness.start_project&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E687A&quot;&gt;arguments 必须是 {}。Brief 不从工具参数传，从 session.working_brief 物化。&lt;/font&gt;" vertex="1">
          <mxGeometry height="680" width="760" x="60" y="980" as="geometry" />
        </mxCell>
        <mxCell id="ps1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" value="&lt;b&gt;闸门&lt;/b&gt;&lt;br&gt;看 JSON 不是对白&lt;br&gt;topic / communication.goal&lt;br&gt;audience.description&lt;br&gt;target.platform&lt;br&gt;target.duration_target_ms&lt;br&gt;缺一项禁止调用" vertex="1">
          <mxGeometry height="200" width="220" x="80" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="ps2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" value="&lt;b&gt;MCP 实现&lt;/b&gt;&lt;br&gt;materialize_brief&lt;br&gt;→ CreativeBrief&lt;br&gt;execute_start_project&lt;br&gt;写 project_dir&lt;br&gt;回写 session.progress" vertex="1">
          <mxGeometry height="200" width="220" x="320" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="ps3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#BFDBFE;strokeColor=#1D4ED8;fontSize=12;" value="&lt;b&gt;Harness 执行&lt;/b&gt;&lt;br&gt;NarrativeHarnessController.run(brief)&lt;br&gt;内部组 TaskEnvelope&lt;br&gt;GenericAgent 调 narrative MCP&lt;br&gt;Critic → commit&lt;br&gt;&lt;font color=&quot;#1E3A8A&quot;&gt;只跑 narrative，不连跑 voice&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="250" x="550" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="ps4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontSize=12;" value="&lt;b&gt;感知层拿到什么&lt;/b&gt;&lt;br&gt;ok / project_dir / progress 枚举&lt;br&gt;对用户说「脚本好了，可以继续做配音吗？」&lt;br&gt;后续阶段：Studio 门禁 continue，或再进感知层问改哪" vertex="1">
          <mxGeometry height="160" width="720" x="80" y="1280" as="geometry" />
        </mxCell>

        <mxCell id="path-read" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontSize=12;" value="&lt;b&gt;路径 2　只读　不派工&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E687A&quot;&gt;读账本投影，不组 Task，不跑 GenericAgent。&lt;/font&gt;" vertex="1">
          <mxGeometry height="680" width="760" x="840" y="980" as="geometry" />
        </mxCell>
        <mxCell id="pr1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;" value="&lt;b&gt;harness.inspect {}&lt;/b&gt;&lt;br&gt;读 project_state.json&lt;br&gt;刷新 progress 七阶段枚举&lt;br&gt;不把剧本塞回对话" vertex="1">
          <mxGeometry height="140" width="720" x="860" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="pr2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;" value="&lt;b&gt;description.list_outline / get_element&lt;/b&gt;&lt;br&gt;大纲：ref / kind / order / title&lt;br&gt;单元素正文，一次一个 ref&lt;br&gt;用来对上「第几段」" vertex="1">
          <mxGeometry height="140" width="720" x="860" y="1220" as="geometry" />
        </mxCell>
        <mxCell id="pr3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#F1F5F9;strokeColor=#64748B;fontSize=12;" value="&lt;b&gt;harness.list_graph&lt;/b&gt;&lt;br&gt;无参：只 artifact:* 的 status / locked / produced_by&lt;br&gt;around_ref：该节点 + 一跳。beat: 会尝试别名到 planned_beat / realized_beat" vertex="1">
          <mxGeometry height="140" width="720" x="860" y="1380" as="geometry" />
        </mxCell>

        <mxCell id="path-repair" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFFFF;strokeColor=#E29A35;strokeWidth=2;fontSize=12;" value="&lt;b&gt;路径 3　改段　harness.repair&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5E687A&quot;&gt;感知层只填 target_refs + instruction。谁跑、跑几张 task，由 Scheduler 从图上算。&lt;/font&gt;" vertex="1">
          <mxGeometry height="680" width="760" x="1620" y="980" as="geometry" />
        </mxCell>
        <mxCell id="pp1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FFEDD5;strokeColor=#EA580C;fontSize=12;" value="&lt;b&gt;感知层交出&lt;/b&gt;&lt;br&gt;target_refs[]　图上的节点&lt;br&gt;instruction　给制作 agent 的一句&lt;br&gt;不选 narrative_agent / voice_agent&lt;br&gt;不手工加 dependents" vertex="1">
          <mxGeometry height="160" width="720" x="1640" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="pp2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=12;" value="&lt;b&gt;Harness 规划　RepairScheduler.plan&lt;/b&gt;&lt;br&gt;校验节点存在 → 收 stale 上游 → 切可执行前沿&lt;br&gt;按 produced_by 组 TaskEnvelope（scope / allowed_tools / snapshot）" vertex="1">
          <mxGeometry height="140" width="720" x="1640" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="pp3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;dashed=1;dashPattern=8 8;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#5E687A;fontSize=12;" value="&lt;b&gt;执行　当前未接线&lt;/b&gt;&lt;br&gt;设计：StageRunner → *HarnessController.run(task) → GenericAgent&lt;br&gt;现状：harness.repair 返回「执行器未接线」。Studio RepairService 才是完整循环。" vertex="1">
          <mxGeometry height="140" width="720" x="1640" y="1400" as="geometry" />
        </mxCell>

        <mxCell id="e-u-h1" edge="1" parent="1" source="u-in" target="h1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeWidth=2;strokeColor=#172033;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
